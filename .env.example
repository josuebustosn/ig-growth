# Copia este archivo a .env.local y completa los valores.
#
# ⚠️ Las NEXT_PUBLIC_* se inlinean en tiempo de BUILD, no se leen en runtime.
#    Configúralas antes del primer deploy; cambiar una después exige redeploy,
#    no alcanza con editarla en el panel.

# ─── Obligatorias ──────────────────────────────────────────────────────────
# Token de la API de Apify. https://console.apify.com/settings/integrations
APIFY_TOKEN=

# Cuenta de Instagram que se monitorea. Es la única que la API va a scrapear:
# la ruta la lee del servidor e ignora el query string.
NEXT_PUBLIC_INSTAGRAM_USERNAME=piremos.app

# ─── Persistencia ──────────────────────────────────────────────────────────
# Si está definida, el histórico va a Vercel Blob; si no, a data/*.json en disco.
#
# 🔴 En Vercel es OBLIGATORIA, y el store tiene que ser PRIVADO: las lecturas
#    consistentes no existen en stores públicos, y sin ellas cada ciclo
#    read-modify-write pierde actualizaciones en silencio.
#
# 🔴 Si falta, esto NO falla ruidosamente: cae a disco, responde 200 con
#    normalidad, y el histórico se borra en cada cold start sin ningún error.
#    Verificala explícitamente después de desplegar.
BLOB_READ_WRITE_TOKEN=

# ─── Opcionales ────────────────────────────────────────────────────────────
# Segundos de espera al Actor de Apify antes de rendirse (default: 50).
# Conviene dejarlo por debajo del límite de duración de función de tu plan.
# APIFY_WAIT_SECS=50

# Secreto del cron. Si está definida, /api/cron/refresh exige el header
# `Authorization: Bearer <valor>`. Vercel Cron lo manda solo si la definís acá.
# CRON_SECRET=

# ─── Marca ─────────────────────────────────────────────────────────────────
# Todo lo de abajo es opcional: sin nada configurado, el dashboard usa la
# instancia de este repo (Piremos). Para otra marca, cambia estos valores y
# pon tus archivos en public/.
#
# Los colores se aceptan con o sin '#'. Sin comillas, el '#' abre un comentario
# en un archivo .env y el valor llega vacío — por eso ambas formas funcionan.

# NEXT_PUBLIC_BRAND_NAME=Piremos
# NEXT_PUBLIC_PRODUCT_NAME=Stats
# NEXT_PUBLIC_BRAND_DESCRIPTION=Crecimiento diario de seguidores de Piremos en Instagram.
# NEXT_PUBLIC_SHARE_DOMAIN=stats.piremos.com

# Rutas dentro de public/
# NEXT_PUBLIC_BRAND_HEADER_LOGO=/piremos-icono.png
# NEXT_PUBLIC_BRAND_FAVICON=/piremos-icono.svg
# NEXT_PUBLIC_BRAND_CANVAS_LOGO=/piremos-icono-blanco.png

# Fondo de la imagen que se comparte: un color, o una ruta a una imagen
# (esta última se dibuja desenfocada y oscurecida). Default: el color oscuro.
# NEXT_PUBLIC_BRAND_SHARE_BG=0F032D

# Las seis de las que se deriva TODA la interfaz vía color-mix().
# NEXT_PUBLIC_BRAND_PRIMARY=4E2BCC
# NEXT_PUBLIC_BRAND_ACCENT=9471FF
# NEXT_PUBLIC_BRAND_POSITIVE=C4F333
# NEXT_PUBLIC_BRAND_NEGATIVE=FF6B6B
# NEXT_PUBLIC_BRAND_DARK=0F032D
# NEXT_PUBLIC_BRAND_LIGHT=EFEFEF
